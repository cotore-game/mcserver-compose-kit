#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export MCSERVER_KIT_CONFIG="${MCSERVER_KIT_CONFIG:-${HOME}/.config/mcserver-compose-kit/config.yml}"
export MCSERVER_KIT_MCID_TEMPLATE_DIR="${MCSERVER_KIT_MCID_TEMPLATE_DIR:-${HOME}/.config/mcserver-compose-kit/mcid-templates}"

show_help() {
  cat <<'HELP'
mcserver-kit - Minecraft Java配布ワールド用サーバー作成ツール

使い方:
  mcserver-kit [create]
  mcserver-kit setup
  mcserver-kit uninstall [--purge]
  mcserver-kit --help

コマンド:
  create               対話形式で新しいサーバーを作成します（省略時の動作）
  setup                Owner、EULA、MCIDテンプレート、Playit等を設定します
  uninstall            本体を削除し、設定とMCIDテンプレートは保持します
  uninstall --purge    本体、設定、MCIDテンプレートをすべて削除します
  help                 このヘルプを表示します

設定:
  ~/.config/mcserver-compose-kit/config.yml
  ~/.config/mcserver-compose-kit/mcid-templates/
HELP
}

command_name="${1-create}"
case "$command_name" in
  create)
    shift || true
    exec "${SCRIPT_DIR}/new-minecraft-server.sh" "$@"
    ;;
  setup)
    shift
    exec "${SCRIPT_DIR}/setup.sh" "$@"
    ;;
  uninstall)
    shift
    exec "${SCRIPT_DIR}/uninstall.sh" "$@"
    ;;
  help | --help | -h)
    show_help
    ;;
  *)
    printf '不明なコマンドです: %s\n\n' "$command_name" >&2
    show_help >&2
    exit 2
    ;;
esac
