#!/usr/bin/env bash
# `tr` is the repository translation helper, and load_messages takes no CLI args.
# shellcheck disable=SC2020,SC2119
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LIBEXEC_DIR="${MCSERVER_KIT_LIBEXEC_DIR:-${SCRIPT_DIR}/libexec/mcserver-kit}"
SHARE_DIR="${MCSERVER_KIT_SHARE_DIR:-${SCRIPT_DIR}/share/mcserver-kit}"
VERSION_FILE="${SCRIPT_DIR}/VERSION"
MCSERVER_KIT_VERSION="$(head -n 1 "$VERSION_FILE" 2>/dev/null || printf unknown)"
export MCSERVER_KIT_ROOT="$SCRIPT_DIR"
export MCSERVER_KIT_LIBEXEC_DIR="$LIBEXEC_DIR"
export MCSERVER_KIT_SHARE_DIR="$SHARE_DIR"
export MCSERVER_KIT_CONFIG="${MCSERVER_KIT_CONFIG:-${HOME}/.config/mcserver-compose-kit/config.yml}"
export MCSERVER_KIT_MCID_TEMPLATE_DIR="${MCSERVER_KIT_MCID_TEMPLATE_DIR:-${HOME}/.config/mcserver-compose-kit/mcid-templates}"
export MCSERVER_KIT_LANGUAGE_FILE="${MCSERVER_KIT_LANGUAGE_FILE:-${HOME}/.config/mcserver-compose-kit/language}"

if [[ "${1-}" == '--lang' ]]; then
  [[ -n "${2-}" ]] || {
    printf '%s\n' '--lang requires a language code.' >&2
    exit 2
  }
  export MCSERVER_KIT_LANG="$2"
  shift 2
fi

# shellcheck source=libexec/mcserver-kit/i18n.sh
source "${LIBEXEC_DIR}/i18n.sh"
load_messages

show_help() {
  printf 'mcserver-kit %s - %s\n\n' "$MCSERVER_KIT_VERSION" "$(tr cli.description)"
  tr cli.usage
  printf '\n'
  cat <<HELP
  mcserver-kit
  mcserver-kit home
  mcserver-kit create
  mcserver-kit setup
  mcserver-kit config
  mcserver-kit templates
  mcserver-kit list
  mcserver-kit server <server-id> <action>
  mcserver-kit lang --ja|--en
  mcserver-kit reset [--yes]
  mcserver-kit uninstall [--purge]
  mcserver-kit --lang <code> [command]
  mcserver-kit --version
  mcserver-kit --help
HELP
  printf '\n'
  tr cli.commands
  printf '\n'
  printf '  %-20s %s\n' home "$(tr cli.home)"
  printf '  %-20s %s\n' create "$(tr cli.create)"
  printf '  %-20s %s\n' setup "$(tr cli.setup)"
  printf '  %-20s %s\n' config "$(tr cli.config)"
  printf '  %-20s %s\n' templates "$(tr cli.templates)"
  printf '  %-20s %s\n' list "$(tr cli.list)"
  printf '  %-20s %s\n' server "$(tr cli.server)"
  printf '  %-20s %s\n' lang "$(tr cli.lang)"
  printf '  %-20s %s\n' reset "$(tr cli.reset)"
  printf '  %-20s %s\n' uninstall "$(tr cli.uninstall)"
  printf '  %-20s %s\n' 'uninstall --purge' "$(tr cli.uninstall_purge)"
  printf '  %-20s %s\n' help "$(tr cli.help)"
  printf '  %-20s %s\n' version "$(tr cli.version)"
  printf '\n'
  tr cli.settings
  printf '\n'
  cat <<HELP
  ~/.config/mcserver-compose-kit/config.yml
  ~/.config/mcserver-compose-kit/mcid-templates/
HELP
}

if [[ $# -eq 0 ]]; then
  if [[ -t 0 && -t 1 ]]; then
    exec "${LIBEXEC_DIR}/home-tui.sh"
  fi
  show_help
  exit 0
fi

command_name="$1"
case "$command_name" in
  home)
    shift
    exec "${LIBEXEC_DIR}/home-tui.sh" "$@"
    ;;
  create)
    shift || true
    exec "${LIBEXEC_DIR}/create-server.sh" "$@"
    ;;
  setup)
    shift
    exec "${LIBEXEC_DIR}/setup.sh" "$@"
    ;;
  config)
    shift
    exec "${LIBEXEC_DIR}/config-tui.sh" "$@"
    ;;
  templates)
    shift
    exec "${LIBEXEC_DIR}/config-tui.sh" templates "$@"
    ;;
  list)
    shift
    exec "${LIBEXEC_DIR}/server-manager.sh" list "$@"
    ;;
  server)
    shift
    exec "${LIBEXEC_DIR}/server-manager.sh" server "$@"
    ;;
  lang)
    shift
    exec "${LIBEXEC_DIR}/lang.sh" "$@"
    ;;
  reset)
    shift
    exec "${LIBEXEC_DIR}/reset.sh" "$@"
    ;;
  uninstall)
    shift
    exec "${LIBEXEC_DIR}/uninstall.sh" "$@"
    ;;
  help | --help | -h)
    show_help
    ;;
  version | --version | -V)
    printf 'mcserver-kit %s\n' "$MCSERVER_KIT_VERSION"
    ;;
  *)
    tr cli.unknown "$command_name" >&2
    show_help >&2
    exit 2
    ;;
esac
